# TimeTrack Environment Variables Example
# Copy this file to .env (or .env.local) and fill real values as needed.
# Only VITE_* variables are exposed to the browser.

# === Firebase (current app loads from src/config/firebase.config.js) ===
# Future enhancement: make firebase.config.js read these so staging/prod can be switched without code changes.
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=...
# VITE_FIREBASE_APP_ID=1:...

# === Emulator / Dev toggles (supported today) ===
VITE_USE_EMULATORS=false

# === Optional feature flags ===
# VITE_TEST_MODE=false

# === App domain (used in a few places) ===
# VITE_APP_DOMAIN=yourdomain.com
